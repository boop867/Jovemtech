{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "../dist/typescript",
    "module": "nodenext",
    "target": "es2022",
    "types": ["node"],
    "sourceMap": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true
  },
  "include": ["*.ts"],
  "exclude": ["../node_modules", "../dist"]
}
